# Скопируй в .env и заполни реальными значениями. Никогда не коммить .env.

# Phase 1+ (LLM API) — не нужны для Phase 0
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Phase 1+ (интеграции) — на Phase 0 integrations/* работают как заглушки без них
BITRIX24_WEBHOOK_URL=
FUSIONPOS_API_KEY=

# Phase 2+ (Telegram bot — dispatch logic works without it, only real Bot API polling needs it)
TELEGRAM_BOT_TOKEN=

# Phase 2+ (Google Calendar — integrations/google_calendar.py is a stub without these)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
